# Infrastructure-oriented runtime settings for the Bronze-to-Silver project.
# All production read/write paths are S3-based. EC2 is compute only.
# Bronze input layout:
#   <BRONZE_S3_ROOT>/Source=NSV/Zone=<Z>/Phase=<P>/Cycle=<C>/UPC=<UPC>/...
#   <BRONZE_S3_ROOT>/Source=NSV_Backup/Zone=<Z>/Phase=<P>/Cycle=<C>/UPC=<UPC>/...

# ── AWS / S3 ───────────────────────────────────────────────────────────────────
AWS_REGION="${AWS_REGION:-ap-south-1}"
BUCKET="${BUCKET:-dhms-new-stgae}"

# Bronze source bucket prefix. The double slash after the bucket key is part of the real prefix.
RAW_S3_ROOT="${RAW_S3_ROOT:-s3://nhai-dhms-uat/nsv-extracted-bronze-layer//unity-catalog/7474657023733156/__unitystorage/catalogs/55f24056-457d-4fa3-8b3e-37e087c38424/volumes/c64fa424-f253-41fb-88aa-7cc7169eea13/final_bronze_output}"
BRONZE_S3_ROOT="${BRONZE_S3_ROOT:-${RAW_S3_ROOT}}"
BRONZE_NSV_ROOT="${BRONZE_NSV_ROOT:-${BRONZE_S3_ROOT}/Source=NSV}"
BRONZE_NSV_BACKUP_ROOT="${BRONZE_NSV_BACKUP_ROOT:-${BRONZE_S3_ROOT}/Source=NSV_Backup}"

# Silver output prefix follows the operational pipeline contract.
SILVER_S3_ROOT="${SILVER_S3_ROOT:-s3://dhms-new-stgae/DHMS/NSV/Silver}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${SILVER_S3_ROOT}}"

# Other S3 directories
IMAGE_ROOT="${IMAGE_ROOT:-s3://dhms-new-stgae/DHMS/NSV/images}"
WORK_DIR="${WORK_DIR:-s3://dhms-new-stgae/DHMS/NSV/work}"
TRACKER_S3="${TRACKER_S3:-s3://dhms-new-stgae/DHMS/NSV/NSV_Activity_Tracker_ZoneWise_Standardized_17072026.xlsx}"

# S3-aware aliases used by the app runtime.
BRONZE_ROOT="${BRONZE_S3_ROOT}"
SILVER_ROOT="${SILVER_S3_ROOT}"
TRACKER_PATH="${TRACKER_S3}"

# ── Default execution values ─────────────────────────────────────────────────
ZONE="${ZONE:-B}"
PHASE="${PHASE:-2}"
CYCLE="${CYCLE:-1}"
UPC="${UPC:-N_07024_01001_GJ}"

# ── Silver output and execution log paths ────────────────────────────────────

# UPC-level Silver directory
SILVER_UPC_ROOT="${SILVER_S3_ROOT}/zone=${ZONE}/phase=${PHASE}/cycle=${CYCLE}/${UPC}"

# Silver data output directory
SILVER_DATA_OUTPUT_DIR="${SILVER_UPC_ROOT}/dlm_kpi_new"

# Execution log directory
LOG_DIR="${SILVER_UPC_ROOT}"

# Execution log file
RUN_LOG_S3="${SILVER_UPC_ROOT}/run.log"

# ── Example values for the actual S3 layout in this project ───────────────────
# Bronze source objects live under:
#   <BRONZE_S3_ROOT>/Source=NSV/Zone=<Z>/Phase=<P>/Cycle=<C>/UPC=<UPC>/year=/month=/day=/...
#   <BRONZE_S3_ROOT>/Source=NSV_Backup/Zone=<Z>/Phase=<P>/Cycle=<C>/UPC=<UPC>/year=/month=/day=/...
# Silver output is published under:
#   s3://dhms-new-stgae/DHMS/NSV/Silver/
