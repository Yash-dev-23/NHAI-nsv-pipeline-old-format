#!/usr/bin/env bash
# Infrastructure-oriented runtime settings for the Bronze-to-Silver project.
# All production read/write paths are S3-based. EC2 is compute only.
# Bronze input layout:
#   <BRONZE_S3_ROOT>/Source=NSV/Zone=<Z>/Phase=<P>/Cycle=<C>/UPC=<UPC>/...
#   <BRONZE_S3_ROOT>/Source=NSV_Backup/Zone=<Z>/Phase=<P>/Cycle=<C>/UPC=<UPC>/...

AWS_REGION="${AWS_REGION:-ap-south-1}"
BUCKET="${BUCKET:-dhms-new-stgae}"

# Bronze source bucket prefix.
RAW_S3_ROOT="${RAW_S3_ROOT:-s3://nhai-dhms-uat/nsv-extracted-bronze-layer//unity-catalog/7474657023733156/__unitystorage/catalogs/55f24056-457d-4fa3-8b3e-37e087c38424/volumes/c64fa424-f253-41fb-88aa-7cc7169eea13/final_bronze_output}"
BRONZE_S3_ROOT="${BRONZE_S3_ROOT:-${RAW_S3_ROOT}}"
BRONZE_NSV_ROOT="${BRONZE_NSV_ROOT:-${BRONZE_S3_ROOT}/Source=NSV}"
BRONZE_NSV_BACKUP_ROOT="${BRONZE_NSV_BACKUP_ROOT:-${BRONZE_S3_ROOT}/Source=NSV_Backup}"

# Silver output root (base only; per-run partition paths are computed by run_upc.sh).
SILVER_S3_ROOT="${SILVER_S3_ROOT:-s3://dhms-new-stgae/DHMS/NSV/Silver}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${SILVER_S3_ROOT}}"

# Defect image files. Notebook walks {UPC}/deliverable and keeps jpg/png whose folder path contains crack or pothole.
# Example: .../Zone_B/Phase_1/Cycle_2/N_02001_09001_RJ/deliverable/Deliverable - 3 - GIS Mapping/Cracking Images/
NSV_DOWNLOADS_ROOT="${NSV_DOWNLOADS_ROOT:-s3://nhai-dhms-uat/nsv-dowloads-raw//unity-catalog/7474657023733156/__unitystorage/catalogs/55f24056-457d-4fa3-8b3e-37e087c38424/volumes/6fb3a2ad-d441-4118-84d9-c5b01fe405db}"
WORK_DIR="${WORK_DIR:-s3://dhms-new-stgae/DHMS/NSV/work}"
TRACKER_S3="${TRACKER_S3:-s3://dhms-new-stgae/NSV_Pipeline/NSV_Activity_Tracker_ZoneWise_Standardized_17072026.xlsx}"
BATCH_LOG_S3="${BATCH_LOG_S3:-s3://dhms-new-stgae/DHMS/NSV/logs}"

# Defaults for direct Python invocation and stand-alone execution.
ZONE="${ZONE:-B}"
PHASE="${PHASE:-2}"
CYCLE="${CYCLE:-1}"
UPC="${UPC:-N_07024_01001_GJ}"

# Do not precompute SILVER_UPC_ROOT, SILVER_DATA_OUTPUT_DIR, LOG_DIR, or
# RUN_LOG_S3 here. run_upc.sh resolves them only after the current UPC's
# Zone/Phase/Cycle/UPC arguments have been applied.
